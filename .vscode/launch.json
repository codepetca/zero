{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Zero Dev · Coin Game",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/zero-dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Zero Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/student-template"
      ],
      "preLaunchTask": "Zero: Prepare extension"
    }
  ]
}

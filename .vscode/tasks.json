{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "zero",
      "task": "run",
      "label": "Zero: Run App",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$zero-java"
    },
    {
      "label": "Zero: Prepare design",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/design/prepare.mjs",
        "--extension"
      ],
      "problemMatcher": []
    },
    {
      "label": "Zero: Prepare lessons",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/lesson-projects.mjs"],
      "problemMatcher": []
    },
    {
      "label": "Zero: Prepare extension",
      "dependsOrder": "sequence",
      "dependsOn": ["Zero: Prepare design", "Zero: Prepare lessons"],
      "problemMatcher": []
    }
  ]
}

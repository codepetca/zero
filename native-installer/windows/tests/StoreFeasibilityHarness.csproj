<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ZERO_STORE</DefineConstants>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ZeroDistribution)' == 'Store'">
    <DefineConstants>$(DefineConstants);ZERO_STORE_PRODUCTION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="StoreFeasibilityHarness.cs;RuntimeHarness.cs;../Distribution.cs;../NativeSetupBackend.cs;../AutomaticSetupController.cs;../KitFiles.cs;../Processes.cs;../WindowsRuntime.cs;../WindowsRuntimeFiles.cs;../WindowsRuntimeHost.cs" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>

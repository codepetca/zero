{
  "name": "zero-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Local Java teaching kit with a quiet VS Code sidebar",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/zero-dev.mjs",
    "dev:prepare": "node scripts/zero-dev.mjs prepare",
    "dev:ui": "node scripts/zero-dev.mjs ui",
    "dev:game": "node scripts/zero-dev.mjs game",
    "dev:smoke": "node scripts/zero-dev.mjs smoke",
    "test:dev": "node --test scripts/zero-dev.test.mjs",
    "prepare:starter": "node scripts/prepare-starter.mjs",
    "prepare:lessons": "node scripts/lesson-projects.mjs",
    "prepare:tutorial-templates": "node scripts/prepare-project-templates.mjs --tutorials",
    "check:tutorial-templates": "node scripts/check-tutorial-templates.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test-extension.mjs",
    "package": "node scripts/package.mjs",
    "package:installers": "npm run package && npm run verify:kit && node scripts/build-installers.mjs",
    "test:installers": "node --test scripts/installers.test.mjs",
    "verify:installers": "node scripts/verify-installers.mjs",
    "release:prepare:mac": "node scripts/mac-release.mjs",
    "test:release:mac": "node --test scripts/mac-release.test.mjs",
    "release:prepare:updates": "node scripts/mac-update-release.mjs",
    "test:updates": "node --test scripts/mac-updater.test.mjs scripts/mac-update-feed.test.mjs",
    "test:updates:live": "node scripts/test-mac-updater-live.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "test:release": "node --test scripts/release-review.test.mjs scripts/release-publish.test.mjs",
    "verify:kit": "node scripts/verify-kit.mjs",
    "verify:framework": "node scripts/verify-framework.mjs",
    "verify:web": "node scripts/verify-web-export.mjs --browser",
    "test:web": "node --test extension/test/web-export-*.test.js extension/test/web-publish-*.test.js",
    "test:sharing": "node --test sharing/test/*.test.mjs",
    "test:jams": "node --test jams/test/*.test.mjs website/tests/jams-*.test.mjs website/tests/jam-*.test.mjs",
    "sharing": "node sharing/cli.mjs",
    "prepare:design": "node design/prepare.mjs",
    "test:msix": "node --test scripts/windows-msix.test.mjs",
    "package:windows:msix": "node scripts/build-windows-msix.mjs",
    "test:windows": "node scripts/test-windows.mjs",
    "test:updates:windows": "node --test setup/tests/windows-updater.test.mjs setup/tests/windows-package.test.mjs setup/tests/windows-key-provisioning.test.mjs setup/tests/windows-signing.test.mjs",
    "setup:updates:windows": "node scripts/provision-windows-updater.mjs",
    "package:windows:production": "node scripts/build-windows-production.mjs",
    "verify:games": "node scripts/verify-basic-games.mjs --native --export"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@vscode/vsce": "4.0.0",
    "fflate": "0.8.3",
    "parse5": "8.0.1"
  },
  "dependencies": {
    "@vercel/blob": "2.8.1"
  }
}

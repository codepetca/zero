{
  "name": "zero-local-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node service/server.mjs",
    "test:report": "node --test service/report.test.mjs",
    "test:service": "node --test service/service.test.mjs",
    "test:postgres": "node service/test-postgres.mjs",
    "migrate": "node service/migrate.mjs",
    "checker": "node service/checker.mjs",
    "publisher": "node service/publisher.mjs",
    "backup": "node service/backup-cli.mjs",
    "test:backup": "node --test service/backup.test.mjs service/backup-postgres.test.mjs",
    "release:availability": "node service/release-availability-cli.mjs",
    "test:availability": "node --test service/release-availability.test.mjs service/release-availability-postgres.test.mjs",
    "test:staging": "node --test service/staging.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}

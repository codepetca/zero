{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "zero",
      "task": "run",
      "label": "Zero: Run App",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$zero-java"
    },
    {
      "label": "Run App without Zero",
      "type": "shell",
      "command": "${workspaceFolder}/mvnw",
      "windows": {
        "command": "${workspaceFolder}\\mvnw.cmd"
      },
      "args": [
        "clean",
        "compile",
        "javafx:run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "java",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\[ERROR\\] (.+):\\[(\\d+),(\\d+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}

{
  "name": "zero",
  "displayName": "Zero",
  "description": "A small local Java teaching sidebar.",
  "version": "0.5.50",
  "publisher": "zero",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:zero.json",
    "workspaceContains:student-template/zero.json",
    "onTaskType:zero",
    "onCommand:zero.startProject",
    "onCommand:zero.cloneRepository",
    "onCommand:zero.openLocalProject",
    "onWebviewPanel:zero.tutorials",
    "onWebviewPanel:zero.startPage"
  ],
  "scripts": {
    "test": "node --test",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "node ../scripts/lesson-projects.mjs && node ../scripts/prepare-tutorials.mjs && node ../design/prepare.mjs --extension",
    "pretest": "node ../scripts/lesson-projects.mjs && node ../scripts/prepare-tutorials.mjs && node ../design/prepare.mjs --extension"
  },
  "contributes": {
    "commands": [
      {
        "command": "zero.getStarted",
        "title": "Zero: Get Started"
      },
      {
        "command": "zero.checkForUpdates",
        "title": "Zero: Check for Updates",
        "enablement": "isMac || isWindows"
      },
      {
        "command": "zero.updateSettings",
        "title": "Zero: Update Settings",
        "enablement": "isMac || isWindows"
      },
      {
        "command": "zero.startProject",
        "title": "Zero: Start Tutorial"
      },
      {
        "command": "zero.cloneRepository",
        "title": "Zero: Clone from GitHub"
      },
      {
        "command": "zero.openLocalProject",
        "title": "Zero: Open Local Project"
      },
      {
        "command": "zero.githubAccount",
        "title": "Zero: GitHub Account"
      },
      {
        "command": "zero.chooseRepository",
        "title": "Zero: Repository Actions"
      },
      {
        "command": "zero.switchBranch",
        "title": "Zero: Switch Branch"
      },
      {
        "command": "zero.toggleApp",
        "title": "Zero: Run or Stop App"
      },
      {
        "command": "zero.runApp",
        "title": "Zero: Run App"
      },
      {
        "command": "zero.openRunningAppInBrowser",
        "title": "Zero: Open Web Export Preview in Browser"
      },
      {
        "command": "zero.runNativeApp",
        "title": "Zero: Run Native App"
      },
      {
        "command": "zero.stopApp",
        "title": "Zero: Stop App"
      },
      {
        "command": "zero.exportWeb",
        "title": "Zero: Export for Web"
      },
      {
        "command": "zero.publishWeb",
        "title": "Zero: Publish App"
      },
      {
        "command": "zero.copyPublishedWebLink",
        "title": "Zero: Copy Playable Link"
      },
      {
        "command": "zero.openPublishedWeb",
        "title": "Zero: Open Published App"
      },
      {
        "command": "zero.previewWebExport",
        "title": "Zero: Preview Web Export"
      },
      {
        "command": "zero.saveWebExport",
        "title": "Zero: Save Web Export ZIP"
      },
      {
        "command": "zero.shareWebExport",
        "title": "Zero: Share Web Export"
      },
      {
        "command": "zero.signInToGitHub",
        "title": "Zero: Sign in to GitHub"
      },
      {
        "command": "zero.createRepository",
        "title": "Zero: Create GitHub Repository"
      },
      {
        "command": "zero.uploadToGitHub",
        "title": "Zero: Commit & Push"
      },
      {
        "command": "zero.connectRepository",
        "title": "Zero: Connect Repository"
      },
      {
        "command": "zero.copyRepositoryLink",
        "title": "Zero: Copy Repository Link"
      },
      {
        "command": "zero.openFirstLesson",
        "title": "Zero: Tutorials",
        "shortTitle": "Tutorials"
      },
      {
        "command": "zero.showProblems",
        "title": "Zero: Show Problems"
      },
      {
        "command": "zero.showSetup",
        "title": "Zero: Troubleshooting",
        "shortTitle": "Troubleshooting"
      },
      {
        "command": "zero.showSidebar",
        "title": "Zero: Show Sidebar"
      },
      {
        "command": "zero.chooseBranch",
        "title": "Zero: Change Actions"
      },
      {
        "command": "zero.startChange",
        "title": "Zero: New Branch"
      },
      {
        "command": "zero.finishChange",
        "title": "Zero: Merge to Main"
      },
      {
        "command": "zero.sharingActions",
        "title": "Zero: Libraries and Games",
        "icon": "$(library)"
      },
      {
        "command": "zero.browseHub",
        "title": "Zero: Browse Libraries"
      },
      {
        "command": "zero.browseTutorialPractice",
        "title": "Zero: Browse Tutorial Practice"
      },
      {
        "command": "zero.browseGames",
        "title": "Zero: Browse Games"
      },
      {
        "command": "zero.openProject",
        "title": "Zero: Open Shared Project"
      },
      {
        "command": "zero.extractLibrary",
        "title": "Zero: Extract Library"
      },
      {
        "command": "zero.checkLibrary",
        "title": "Zero: Check Library"
      },
      {
        "command": "zero.shareLibrary",
        "title": "Zero: Share Library"
      },
      {
        "command": "zero.shareGame",
        "title": "Zero: Share Game"
      },
      {
        "command": "zero.switchLibraryMode",
        "title": "Zero: Develop Local Library / Use Published Version"
      },
      {
        "command": "zero.recoverLibraryChange",
        "title": "Zero: Recover Library Change"
      },
      {
        "command": "zero.editSharingDetails",
        "title": "Zero: Edit Sharing Details"
      },
      {
        "command": "zero.browseZeroHub",
        "title": "Zero: ZeroHub"
      },
      {
        "command": "zero.showOutput",
        "title": "Zero: Show Output"
      },
      {
        "command": "zero.newClass",
        "title": "Zero: New class\u2026"
      },
      {
        "command": "zero.newFile",
        "title": "Zero: New file\u2026"
      },
      {
        "command": "zero.newFolder",
        "title": "Zero: New folder\u2026"
      },
      {
        "command": "zero.importAssets",
        "title": "Zero: New asset\u2026"
      },
      {
        "command": "zero.copyImportedAssetPaths",
        "title": "Zero: Copy Imported Asset Paths"
      },
      {
        "command": "zero.recovery",
        "title": "Zero: Review or restore changes\u2026"
      },
      {
        "command": "zero.newProject",
        "title": "Zero: New Project"
      },
      {
        "command": "zero.setupGitHub",
        "title": "Zero: Set Up GitHub"
      },
      {
        "command": "zero.startPage",
        "title": "Zero: Start Page",
        "shortTitle": "Start Page"
      },
      {
        "command": "zero.enableBrowserChecks",
        "title": "Zero: Enable and Prepare Browser Checks"
      },
      {
        "command": "zero.disableBrowserChecks",
        "title": "Zero: Disable Browser Checks"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "zero.controls",
          "name": "Zero",
          "icon": "media/zero.svg"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "zero",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "run",
              "native-run"
            ],
            "description": "Save and run the marked Zero Java project."
          },
          "instanceId": {
            "type": "string",
            "description": "Internal identifier for each Run App command."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "zero-java",
        "owner": "zero-native-task-compatibility",
        "pattern": {
          "regexp": "^(?!)()()()$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      {
        "name": "zero-java-fallback",
        "owner": "java",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\] (.+):\\[(\\d+),(\\d+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "configuration": {
      "title": "Zero",
      "properties": {
        "zero.uploadMode": {
          "type": "string",
          "enum": [
            "simulation",
            "live"
          ],
          "default": "live",
          "scope": "resource",
          "markdownDescription": "Live is the default. GitHub actions require your explicit choice. Commit & push uses an empty Commit Message input; check the repository and branch in the sidebar; naming a new branch creates it directly. First Publish warns that the app and included assets will be public; later Publish actions update that site. Merge to main runs directly after its safety checks. After successful merging, guarded cleanup automatically deletes the finished local branch; the remote branch stays available. Repository replacement keeps a concise confirmation. Uploads commit when needed and send files to your connected repository using your VS Code GitHub sign-in. A local Git name/email identity is required. Simulation is an optional testing mode that makes no Git changes or uploads. Local lesson practice projects remain local-only in either mode."
        },
        "zero.sharingCatalogUrl": {
          "type": "string",
          "default": "https://zero.codepet.ca/api/sharing/catalog/web",
          "scope": "machine",
          "markdownDescription": "Exact generated games/library catalog URL. Public activation is pending; explicit loopback URLs support local verification."
        },
        "zero.sharingArtifactOrigin": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Operator-configured immutable public artifact origin. Blank keeps public downloads unavailable until storage acceptance."
        },
        "zero.sharingPolicyRevision": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Operator-configured reviewed policy revision, stamped by an accepted kit release. Blank keeps publication forms disabled."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "zero.runNativeApp",
          "when": "false"
        },
        {
          "command": "zero.checkForUpdates",
          "when": "isMac || isWindows"
        },
        {
          "command": "zero.updateSettings",
          "when": "isMac || isWindows"
        }
      ],
      "view/title": [
        {
          "command": "zero.githubAccount",
          "when": "view == zero.controls",
          "group": "zero-account@1"
        },
        {
          "command": "zero.chooseRepository",
          "when": "view == zero.controls",
          "group": "zero-project@1"
        },
        {
          "command": "zero.exportWeb",
          "when": "view == zero.controls",
          "group": "zero-web@1"
        },
        {
          "command": "zero.copyPublishedWebLink",
          "when": "view == zero.controls",
          "group": "zero-web@2"
        },
        {
          "command": "zero.openPublishedWeb",
          "when": "view == zero.controls",
          "group": "zero-web@3"
        },
        {
          "command": "zero.openFirstLesson",
          "when": "view == zero.controls",
          "group": "zero-help@1"
        },
        {
          "command": "zero.showSetup",
          "when": "view == zero.controls",
          "group": "zero-help@2"
        },
        {
          "command": "zero.startPage",
          "when": "view == zero.controls",
          "group": "zero-help@0"
        },
        {
          "command": "zero.showOutput",
          "when": "view == zero.controls",
          "group": "zero-help@3"
        }
      ]
    },
    "authentication": [
      {
        "id": "zero-github",
        "label": "Zero GitHub"
      }
    ]
  }
}

{
  "name": "zero-website", "version": "0.5.0", "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare": "node scripts/prepare.mjs", "predev": "npm run prepare", "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run prepare", "build": "next build", "start": "next start --hostname 127.0.0.1",
    "pretypecheck": "npm run prepare", "typecheck": "next typegen && tsc --noEmit", "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "next": "16.4.0", "react": "19.3.0", "react-dom": "19.3.0", "bootstrap-icons": "1.13.2", "react-markdown": "10.1.0", "remark-gfm": "4.0.1" },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "22.20.5", "@types/react": "19.3.0", "@types/react-dom": "19.3.0" }
}

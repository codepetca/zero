{
  "name": "zero-website",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "predev": "npm run prepare",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run prepare",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "pretypecheck": "npm run prepare",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:bundles": "node scripts/audit-function-bundles.mjs --check",
    "check:runtime": "node scripts/check-function-runtime.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.56.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
